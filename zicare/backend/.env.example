APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
# Catatan: port default 8080. Bila bentrok (mis. EDB PEM), jalankan backend di
# port lain dan sesuaikan nilai ini + target proxy di frontend/vite.config.js.
APP_KEY=change-this-to-a-random-32-char-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_db
DB_USER=root
DB_PASS=

JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRY=28800

ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
# API key Odoo (Settings > Users > Preferences > Account Security > API Keys).
# Taruh nilai asli hanya di file .env, JANGAN di .env.example yang masuk git.
ODOO_API_KEY=
ODOO_PASSWORD=
ODOO_SYNC_ENABLED=true
ODOO_SYNC_MAX_RETRY=3

LOG_PATH=storage/logs/app.log
