APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8090
# Backend default berjalan di port 8090 (port 8080 sering dipakai layanan lain,
# mis. EDB PEM). Bila diganti, sesuaikan nilai ini + target proxy di frontend/vite.config.js.
APP_KEY=change-this-to-a-random-32-char-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_db
DB_USER=root
DB_PASS=

JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRY=28800

ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
# API key Odoo (Settings > Users > Preferences > Account Security > API Keys).
# Taruh nilai asli hanya di file .env, JANGAN di .env.example yang masuk git.
ODOO_API_KEY=
ODOO_PASSWORD=
ODOO_JOURNAL_CASH_CODE=CSH1
ODOO_JOURNAL_BANK_CODE=BNK1
ODOO_SYNC_ENABLED=true
ODOO_SYNC_MAX_RETRY=3
# Bila true (default), sinkronisasi Odoo saat checkout dijalankan di proses
# worker terpisah agar respons transaksi tetap cepat. Set false untuk sinkron
# langsung (memblokir) — biasanya hanya untuk pengujian.
ODOO_SYNC_ASYNC=true
# Bila true, POS akan otomatis mengisi akun "Outstanding Receipts" pada payment
# method line Odoo yang kosong, supaya pembayaran ikut terposting ke Accounting
# dan invoice berstatus lunas. Set false bila konfigurasi Odoo dikelola manual.
ODOO_AUTO_CONFIGURE=true
# Opsional: path ke binary PHP CLI untuk worker sinkronisasi latar. Kosongkan
# untuk memakai PHP_BINARY. Isi ini bila PHP web bukan CLI (mis. php-fpm).
# PHP_CLI_BINARY=C:\xampp\php\php.exe

# Comma-separated list of origins allowed to call the API directly.
# Empty = accept any origin (legacy behaviour, useful in dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_PATH=storage/logs/app.log
