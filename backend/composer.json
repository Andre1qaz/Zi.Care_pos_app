{
    "name": "pos/backend",
    "description": "POS Application REST API - Phalcon PHP",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-phalcon": "*",
        "ext-pdo": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
